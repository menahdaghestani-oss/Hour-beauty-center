<style>
:root{
--cream:#F8F4EF;
--white:#FFFCF9;
--beige:#E9DED2;
--pink:#D8A7B1;
--blush:#F3E5E5;
--lavender:#D9CBE5;
--burgundy:#70263D;
--wine:#8F304A;
--gold:#B99A68;
--ink:#392B2D;
--muted:#81736E;
--line:#E6D8CC;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--cream);color:var(--ink);font-family:'Tajawal',sans-serif;line-height:1.8}
a{text-decoration:none;color:inherit}
img{display:block;width:100%;object-fit:cover}
.container{width:min(1180px,90%);margin:auto}
.english{font-family:'Playfair Display',serif;letter-spacing:2px}
.topline{height:4px;background:linear-gradient(90deg,var(--gold),var(--pink),var(--burgundy))}
header{position:sticky;top:0;z-index:20;background:rgba(248,244,239,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.brand{display:flex;align-items:center;gap:11px;color:var(--burgundy)}
.brand-mark{width:43px;height:43px;border:1px solid var(--gold);border-radius:50%;display:grid;place-items:center;font:24px 'Playfair Display',serif}
.brand-name{font:800 20px 'Cairo',sans-serif}
.brand-name small{display:block;font:10px 'Playfair Display',serif;letter-spacing:2px;color:var(--gold);direction:ltr}
.navlinks{display:flex;gap:23px;font-size:15px;font-weight:600}
.navlinks a:hover{color:var(--wine)}
.button,.nav-cta{display:inline-flex;align-items:center;justify-content:center;padding:12px 23px;background:var(--burgundy);color:white;border:1px solid var(--burgundy);font-weight:700;transition:.25s}
.button:hover,.nav-cta:hover{background:var(--wine);transform:translateY(-2px)}
.button-light{display:inline-flex;align-items:center;justify-content:center;padding:12px 23px;border:1px solid var(--gold);color:var(--burgundy);font-weight:700;transition:.25s}
.button-light:hover{background:var(--blush)}
.menu{display:none;background:none;border:1px solid var(--line);padding:6px 12px;color:var(--burgundy);font-size:22px}

/* Hero reception */
.hero{min-height:650px;position:relative;display:flex;align-items:center;overflow:hidden;background:#4B3030}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-position:center 55%}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(35,20,22,.72),rgba(35,20,22,.35) 55%,rgba(35,20,22,.12))}
.hero-content{position:relative;z-index:2;width:min(1180px,90%);margin:auto;color:white;padding:100px 0}
.hero .kicker{color:#E7CDA5;font-size:14px;letter-spacing:2px;margin-bottom:20px}
.hero h1{font:700 clamp(38px,6vw,68px)/1.45 'Cairo',sans-serif;max-width:680px;margin-bottom:18px}
.hero h1 span{color:#E6C99D}
.hero p{font-size:19px;color:#F4EAE4;max-width:570px;margin-bottom:28px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.hero .button{background:var(--burgundy);border-color:var(--burgundy)}
.hero .button-light{background:rgba(255,255,255,.12);color:white;border-color:#E7CDA5}
.hero-tag{margin-top:50px;color:#F0DED3;font-size:14px}

/* Sections */
section{scroll-margin-top:85px}
.section-intro{text-align:center;padding:85px 0 40px}
.section-label{font:13px 'Playfair Display',serif;letter-spacing:3px;color:var(--gold)}
.section-title{font:700 clamp(27px,4vw,42px) 'Cairo',sans-serif;color:var(--burgundy);margin:10px 0}
.section-desc{max-width:690px;margin:auto;color:var(--muted);font-size:17px}
.rule{width:60px;height:1px;background:var(--gold);margin:20px auto}

/* Reception gallery */
.gallery{padding:20px 0 90px}
.gallery-grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:15px}
.gallery-item{height:310px;overflow:hidden;position:relative;background:var(--beige)}
.gallery-item:first-child{height:390px;grid-row:span 2}
.gallery-item img{height:100%;transition:transform .6s}
.gallery-item:hover img{transform:scale(1.045)}
.gallery-caption{position:absolute;bottom:0;right:0;left:0;padding:30px 18px 16px;color:white;background:linear-gradient(transparent,rgba(35,20,22,.7));font-weight:700}

/* About */
.about{background:var(--white);display:grid;grid-template-columns:1fr 1fr}
.about-image img{height:100%;min-height:440px}
.about-copy{padding:75px clamp(30px,7vw,100px);display:flex;flex-direction:column;justify-content:center}
.about-copy h2{font:700 34px 'Cairo',sans-serif;color:var(--burgundy);margin:12px 0 18px}
.about-copy p{color:var(--muted);font-size:17px;margin-bottom:15px}
.signature{font:italic 25px 'Playfair Display',serif;color:var(--gold);margin-top:12px}

/* Services */
.services{padding:35px 0 95px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:42px}
.card{background:var(--white);border:1px solid var(--line);transition:.3s;overflow:hidden}
.card:hover{transform:translateY(-6px);box-shadow:0 15px 35px #70263d12}
.card img{height:225px}
.card-body{padding:22px}
.card-no{font:12px 'Playfair Display',serif;letter-spacing:2px;color:var(--gold)}
.card h3{font:700 21px 'Cairo',sans-serif;color:var(--burgundy);margin:7px 0}
.card p{color:var(--muted);font-size:15px;min-height:55px}
.card a{display:inline-block;color:var(--wine);font-weight:700;margin-top:13px;border-bottom:1px solid var(--gold)}

/* Technology */
.technology{padding:80px 0;background:#F0E9E3}
.tech-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-top:42px}
.tech-card{background:var(--white);display:grid;grid-template-columns:42% 1fr;border:1px solid var(--line)}
.tech-card img{height:100%;min-height:240px}
.tech-copy{padding:25px}
.tech-copy .english{font-size:12px;color:var(--gold)}
.tech-copy h3{font:700 23px 'Cairo',sans-serif;color:var(--burgundy);margin:8px 0}
.tech-copy p{color:var(--muted);font-size:15px}

/* Quote */
.quote{background:var(--burgundy);color:white;text-align:center;padding:70px 20px}
.quote .english{font-size:13px;letter-spacing:4px;color:#E5C798}
.quote h2{font:600 clamp(25px,4vw,38px) 'Cairo',sans-serif;margin:14px 0}
.quote p{color:#E9DADD}

/* Locations */
.locations{padding:90px 0;background:var(--cream)}
.location-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-top:40px}
.location-card{background:var(--white);border:1px solid var(--line)}
.map{height:260px;width:100%;border:0;display:block}
.location-info{padding:24px}
.location-info .english{font-size:12px;color:var(--gold)}
.location-info h3{font:700 23px 'Cairo',sans-serif;color:var(--burgundy)}
.location-info p{color:var(--muted);margin:5px 0 15px}
.map-link{color:var(--wine);font-weight:700;border-bottom:1px solid var(--gold)}

/* Contact */
.contact{padding:90px 0;text-align:center;background:var(--white)}
.contact h2{font:700 clamp(29px,4vw,42px) 'Cairo',sans-serif;color:var(--burgundy);margin:12px 0}
.contact p{color:var(--muted);font-size:17px;margin-bottom:22px}
.phone{display:block;direction:ltr;font:24px 'Playfair Display',serif;color:var(--wine);margin-bottom:22px}
.contact-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}

footer{background:#49202D;color:#F8F4EF;padding:38px 0 24px;text-align:center}
.footer-brand{font:25px 'Cairo',sans-serif;color:#F3E5E5}
footer .english{color:var(--gold);font-size:12px}
.footer-line{height:1px;background:#ffffff30;max-width:400px;margin:20px auto}
footer p{font-size:13px;color:#E7D9D8}
.whatsapp{position:fixed;bottom:20px;left:20px;z-index:15;width:55px;height:55px;border-radius:50%;background:#218C61;color:white;display:grid;place-items:center;font-size:25px;box-shadow:0 8px 25px #0002}

.fade{opacity:0;transform:translateY(16px);transition:.6s}
.fade.show{opacity:1;transform:translateY(0)}

@media(max-width:850px){
.navlinks{display:none;position:absolute;top:78px;right:0;left:0;background:var(--cream);padding:22px;flex-direction:column;border-bottom:1px solid var(--line)}
.navlinks.open{display:flex}.menu{display:block}.nav-cta{display:none}
.about{grid-template-columns:1fr}.about-image img{height:350px;min-height:0}
.cards{grid-template-columns:1fr 1fr}
.gallery-grid{grid-template-columns:1fr 1fr}
.gallery-item:first-child{grid-row:auto;height:310px}
.tech-grid{grid-template-columns:1fr}
}
@media(max-width:560px){
.hero{min-height:590px}.hero-content{padding:80px 0}.hero p{font-size:17px}
.gallery-grid,.cards,.location-grid{grid-template-columns:1fr}
.gallery-item,.gallery-item:first-child{height:260px}
.tech-card{grid-template-columns:1fr}.tech-card img{height:220px;min-height:0}
.section-intro{padding:65px 0 30px}
.about-copy{padding:55px 7%}
}
@media(prefers-reduced-motion:reduce){
html{scroll-behavior:auto}
*,*::before,*::after{transition:none!important}
.fade{opacity:1;transform:none}
}
</style>
</head>

